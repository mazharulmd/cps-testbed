  {"id":"ui_theme","type":"ui-theme","name":"CPS Theme","colors":{"surface":"#ffffff","primary":"#0d47a1","bgPage":"#eceff1","groupBg":"#ffffff","groupOutline":"#cfd8dc"},"sizes":{"density":"default","pagePadding":"12px","groupGap":"12px","groupBorderRadius":"6px","widgetGap":"12px"}},
  {"id":"grp_header","type":"ui-group","name":"Scenario Status","page":"ui_page","width":"12","height":"1","order":1,"showTitle":true,"className":"","visible":true,"disabled":false},
  {"id":"grp_charts","type":"ui-group","name":"Grid Voltage & Network Delay","page":"ui_page","width":"12","height":"1","order":2,"showTitle":true,"className":"","visible":true,"disabled":false},
  {"id":"grp_metrics","type":"ui-group","name":"Network Performance","page":"ui_page","width":"6","height":"1","order":3,"showTitle":true,"className":"","visible":true,"disabled":false},
  {"id":"grp_table","type":"ui-group","name":"Per-Bus Measurement Table","page":"ui_page","width":"6","height":"1","order":4,"showTitle":true,"className":"","visible":true,"disabled":false},
  {"id":"inj_load","type":"inject","z":"cps_tab","name":"Load Latest Scenario","props":[{"p":"payload"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":150,"y":80,"wires":[["read_csv","read_json"]]},
  {"id":"read_csv","type":"file in","z":"cps_tab","name":"read last_compare.csv","filename":"/home/ubuntu/cps-testbed/results/last_compare.csv","filenameType":"str","format":"utf8","chunk":false,"sendError":false,"encoding":"none","allProps":false,"x":390,"y":60,"wires":[["csv_parse"]]},
  {"id":"csv_parse","type":"csv","z":"cps_tab","name":"","spr":",","sep":",","hdrin":true,"hdrout":"none","multi":"mult","ret":"\\n","temp":"","skip":"0","strings":true,"include_empty_strings":false,"include_null_values":false,"x":610,"y":60,"wires":[["fn_vchart","fn_dchart","fn_table"]]},
  {"id":"fn_vchart","type":"function","z":"cps_tab","name":"voltage series","func":"const rows = msg.payload;\nfor (const r of rows) {\n  const bus = Number(r.bus);\n  node.send({ topic: 'True (GridPACK)', payload: Number(r.sent_v), x: bus, y: Number(r.sent_v) });\n  if (r.delivered == 1 && r.recv_v !== '') {\n    node.send({ topic: 'Delivered (NS-3)', payload: Number(r.recv_v), x: bus, y: Number(r.recv_v) });\n  }\n}\nreturn null;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":840,"y":40,"wires":[["chart_volt"]]},
  {"id":"fn_dchart","type":"function","z":"cps_tab","name":"delay series","func":"const rows = msg.payload;\nfor (const r of rows) {\n  const bus = Number(r.bus);\n  if (r.delivered == 1 && r.delay_ms !== '') {\n    node.send({ topic: 'End-to-end delay', payload: Number(r.delay_ms), x: bus, y: Number(r.delay_ms) });\n  }\n}\nreturn null;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":840,"y":80,"wires":[["chart_delay"]]},
  {"id":"fn_table","type":"function","z":"cps_tab","name":"build table","func":"const rows = msg.payload;\nmsg.payload = rows.map(r => ({\n  Bus: Number(r.bus),\n  'True V': Number(r.sent_v).toFixed(4),\n  'Recv V': (r.delivered==1 && r.recv_v!=='') ? Number(r.recv_v).toFixed(4) : '-',\n  'Delay ms': (r.delivered==1 && r.delay_ms!=='') ? Number(r.delay_ms).toFixed(2) : '-',\n  Status: (r.delivered==1) ? 'OK' : 'LOST'\n}));\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":840,"y":120,"wires":[["table_bus"]]},
  {"id":"read_json","type":"file in","z":"cps_tab","name":"read last_summary.json","filename":"/home/ubuntu/cps-testbed/results/last_summary.json","filenameType":"str","format":"utf8","chunk":false,"sendError":false,"encoding":"none","allProps":false,"x":390,"y":160,"wires":[["json_parse"]]},
  {"id":"json_parse","type":"json","z":"cps_tab","name":"","property":"payload","action":"obj","pretty":false,"x":610,"y":160,"wires":[["fn_header","fn_metrics"]]},
  {"id":"fn_header","type":"function","z":"cps_tab","name":"header text","func":"const s = msg.payload;\nmsg.payload = `Scenario: ${s.scenario}  |  Latency: ${s.latency_ms} ms  |  HELICS: ${s.helics_status}  |  Power: ${s.gridpack}  |  Net: ${s.ns3}`;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":840,"y":140,"wires":[["text_header"]]},
  {"id":"fn_metrics","type":"function","z":"cps_tab","name":"metrics text","func":"const s = msg.payload;\nmsg.payload =\n`Delivered: ${s.delivered}/${s.total_buses}\\n` +\n`Lost: ${s.lost}  (${Number(s.loss_actual_pct).toFixed(1)}%)\\n` +\n`Avg delay: ${Number(s.avg_delay_ms).toFixed(2)} ms\\n` +\n`Max delay: ${Number(s.max_delay_ms).toFixed(2)} ms\\n` +\n`Voltage violations: ${s.violations}`;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":840,"y":180,"wires":[["text_metrics"]]},
  {"id":"text_header","type":"ui-text","z":"cps_tab","group":"grp_header","order":1,"width":"12","height":"1","name":"header","label":"","format":"{{msg.payload}}","layout":"row-left","style":false,"font":"","fontSize":14,"color":"#0d47a1","className":"","x":1060,"y":140,"wires":[]},
  {"id":"chart_volt","type":"ui-chart","z":"cps_tab","group":"grp_charts","name":"Voltage","label":"Voltage: True (GridPACK) vs Delivered (NS-3)","order":1,"chartType":"line","category":"topic","categoryType":"property","line":"","interpolation":"linear","pointShape":"circle","pointRadius":4,"showLegend":true,"removeOlder":"1","removeOlderUnit":"3600","removeOlderPoints":"","ymin":"1.0","ymax":"1.1","xAxisLabel":"Bus Number","yAxisLabel":"Voltage (pu)","width":"6","height":"5","className":"","action":"append","stackSeries":false,"xAxisProperty":"x","xAxisPropertyType":"property","yAxisProperty":"y","yAxisPropertyType":"property","x":1080,"y":40,"wires":[[]]},
  {"id":"chart_delay","type":"ui-chart","z":"cps_tab","group":"grp_charts","name":"Delay","label":"End-to-End Network Delay per Bus","order":2,"chartType":"bar","category":"topic","categoryType":"property","line":"","interpolation":"linear","pointShape":"circle","pointRadius":4,"showLegend":false,"removeOlder":"1","removeOlderUnit":"3600","removeOlderPoints":"","ymin":"0","ymax":"","xAxisLabel":"Bus Number","yAxisLabel":"Delay (ms)","width":"6","height":"5","className":"","action":"append","stackSeries":false,"xAxisProperty":"x","xAxisPropertyType":"property","yAxisProperty":"y","yAxisPropertyType":"property","x":1080,"y":80,"wires":[[]]},
  {"id":"text_metrics","type":"ui-text","z":"cps_tab","group":"grp_metrics","order":1,"width":"6","height":"4","name":"metrics","label":"Network Performance","format":"<pre style=\"font-size:15px;line-height:1.6;margin:0\">{{msg.payload}}</pre>","layout":"col-center","style":false,"font":"","fontSize":15,"color":"#263238","className":"","x":1060,"y":180,"wires":[]},
