                "28bd03089bd8c0cb"
            ]
        ]
    },
    {
        "id": "9bab0be9e99cce9e",
        "type": "function",
        "z": "b1091fdc876e5a4e",
        "name": "build table",
        "func": "const rows = msg.payload;\nlet html = `<div style=\"display:flex;justify-content:center;width:100%\"><table style=\"border-collapse:collapse;font-size:14px;margin:0 auto\">\n<tr style=\"background:#0d47a1;color:#fff\">\n<th style=\"padding:6px;border:1px solid #ccc\">Bus</th>\n<th style=\"padding:6px;border:1px solid #ccc\">True V</th>\n<th style=\"padding:6px;border:1px solid #ccc\">Recv V</th>\n<th style=\"padding:6px;border:1px solid #ccc\">Delay ms</th>\n<th style=\"padding:6px;border:1px solid #ccc\">Status</th></tr>`;\nfor (const r of rows) {\n  const lost = (r.delivered != 1);\n  const atk = (r.attacked == 1);\n  let bg = '', status = 'OK', scolor = '#2e7d32';\n  if (lost) { bg = 'background:#ffcdd2'; status = 'LOST'; scolor = '#c62828'; }\n  else if (atk) { bg = 'background:#fff3cd'; status = '⚠ TAMPERED'; scolor = '#e65100'; }\n  html += `<tr style=\"${bg}\">\n<td style=\"padding:5px;border:1px solid #ccc;text-align:center\">${r.bus}</td>\n<td style=\"padding:5px;border:1px solid #ccc;text-align:center\">${Number(r.sent_v).toFixed(4)}</td>\n<td style=\"padding:5px;border:1px solid #ccc;text-align:center\">${lost ? '—' : Number(r.recv_v).toFixed(4)}</td>\n<td style=\"padding:5px;border:1px solid #ccc;text-align:center\">${lost ? '—' : Number(r.delay_ms).toFixed(2)}</td>\n<td style=\"padding:5px;border:1px solid #ccc;text-align:center;font-weight:bold;color:${scolor}\">${status}</td></tr>`;\n}\nhtml += `</table></div>`;\nmsg.payload = html;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 260,
        "wires": [
