        "type": "function",
        "z": "b1091fdc876e5a4e",
        "name": "build command",
        "func": "// validate dashboard input and build the run_scenario_docker.sh arguments\nif (flow.get('running')) {\n    return [null, { status: { running: true, text: 'A scenario is already running…' } }];\n}\nconst p = msg.payload || {};\nconst name = String(p.name || 'web').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 40) || 'web';\nconst latency = Number(p.latency), loss = Number(p.loss), drop = Math.trunc(Number(p.droppmu) || 0);\nif (!(latency >= 0 && latency <= 5000)) return [null, { status: { error: true, text: 'Latency must be 0–5000 ms.' } }];\nif (!(loss >= 0 && loss <= 1)) return [null, { status: { error: true, text: 'Loss must be between 0 and 1.' } }];\nif (!(drop >= 0 && drop <= 14)) return [null, { status: { error: true, text: 'Drop bus must be 0–14.' } }];\n\nlet args = `--latency=${latency} --loss=${loss} --name=${name}`;\nif (p.attack) args += ' --attack=1';\nif (drop > 0) args += ` --droppmu=${drop}`;\n\nflow.set('running', true);\nreturn [{ payload: args },\n        { status: { running: true, text: `Running \"${name}\" (latency ${latency} ms, loss ${loss}${p.attack ? ', FDI attack' : ''}${drop ? ', drop bus ' + drop : ''})…` } }];",
