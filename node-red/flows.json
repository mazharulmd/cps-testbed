    {
        "id": "96fbfd24f2fdcadb",
        "type": "ui-template",
        "z": "b1091fdc876e5a4e",
        "group": "grp_charts",
        "page": "",
        "ui": "",
        "name": "",
        "order": 0,
        "width": "6",
        "height": "6",
        "head": "",
        "format": "<template>\n  <div ref=\"chart\" style=\"width:100%;height:340px\"></div>\n</template>\n\n<script>\nexport default {\n  data() { return { chart: null }; },\n  mounted() {\n    const load = () => {\n      if (!window.echarts) {\n        const s = document.createElement('script');\n        s.src = 'https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js';\n        s.onload = () => this.init();\n        document.head.appendChild(s);\n      } else { this.init(); }\n    };\n    load();\n  },\n  methods: {\n    init() {\n      this.chart = window.echarts.init(this.$refs.chart);\n      this.render(this.lastRows || []);\n    },\n    render(rows) {\n      if (!this.chart || !rows.length) return;\n      const buses = rows.map(r => Number(r.bus));\n      const trueV = rows.map(r => Number(r.sent_v));\n      const recvV = rows.map(r => (r.delivered == 1 && r.recv_v !== '') ? Number(r.recv_v) : null);\n      this.chart.setOption({\n        tooltip: { trigger: 'axis' },\n        legend: { data: ['True (GridPACK)', 'Delivered (NS-3)'], top: 0 },\n        grid: { left: 50, right: 20, top: 40, bottom: 40 },\n        xAxis: { type: 'category', data: buses, name: 'Bus Number', nameLocation: 'middle', nameGap: 25 },\n        yAxis: { type: 'value', name: 'Voltage (pu)', min: 1.0, max: 1.1 },\n        series: [\n          {\n            name: 'True (GridPACK)', type: 'line', data: trueV,\n            color: '#1565C0', symbol: 'circle', symbolSize: 7,\n            label: { show: true, position: 'top', formatter: (p) => 'B' + buses[p.dataIndex], fontSize: 10, color: '#1565C0' }\n          },\n          {\n            name: 'Delivered (NS-3)', type: 'line', data: recvV,\n            color: '#E53935', symbol: 'rect', symbolSize: 7, step: 'middle', connectNulls: false\n          }\n        ]\n      });\n    }\n  },\n  watch: {\n    msg: function(m) {\n      if (m && m.payload && Array.isArray(m.payload)) {\n        this.lastRows = m.payload;\n        this.render(m.payload);\n      }\n    }\n  }\n}\n</script>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
