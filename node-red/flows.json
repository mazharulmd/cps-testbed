        "name": "metrics text",
        "func": "const s = msg.payload;\nconst attackLine = (s.attack && s.attack !== 'none')\n    ? `⚠ ATTACK: ${s.attack} — MISSED violations: ${s.missed_violations}`\n    : `Security: no attack detected`;\nconst line1 = `Delivered: ${s.delivered}/${s.total_buses} &nbsp; | &nbsp; Lost: ${s.lost} (${Number(s.loss_actual_pct).toFixed(1)}%) &nbsp; | &nbsp; Violations seen: ${s.violations_seen_by_pdc} &nbsp; | &nbsp; Avg delay: ${Number(s.avg_delay_ms).toFixed(2)} ms`;\nmsg.payload = `<div style=\"font-size:14px;line-height:1.6\">${line1}<br><span style=\"color:#c62828;font-weight:bold\">${attackLine}</span></div>`;\nreturn msg;",
