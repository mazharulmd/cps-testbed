    {
        "id": "43f7199fc04e2d7f",
        "type": "function",
        "z": "b1091fdc876e5a4e",
        "name": "delay series",
        "func": "const rows = msg.payload;\nfor (const r of rows) {\n    const bus = Number(r.bus);\n    if (r.delivered == 1 && r.delay_ms !== '' && r.delay_ms != null) {\n        // delivered: Normal or Problem bus\n        const isProblem = (Number(r.sent_v) > 1.08) || (r.attacked == 1);\n        node.send({\n            topic: isProblem ? 'Problem bus' : 'Normal',\n            payload: Number(r.delay_ms),\n            x: bus,\n            y: Number(r.delay_ms)\n        });\n    } else {\n        // lost: show a small marker so the gap is visible and labeled\n        node.send({\n            topic: 'Lost',\n            payload: 0,\n            x: bus,\n            y: 1   // small fixed height so it's visible but clearly not a real delay\n        });\n    }\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 200,
        "wires": [
