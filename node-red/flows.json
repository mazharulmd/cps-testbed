    {
        "id": "d0dc46b6b654992a",
        "type": "function",
        "z": "b1091fdc876e5a4e",
        "name": "voltage series",
        "func": "const rows = msg.payload;\nfor (const r of rows) {\n  const bus = Number(r.bus);\n  node.send({ topic: 'True (GridPACK)', payload: Number(r.sent_v), x: bus, y: Number(r.sent_v) });\n  if (r.delivered == 1 && r.recv_v !== '') {\n    node.send({ topic: 'Delivered (NS-3)', payload: Number(r.recv_v), x: bus, y: Number(r.recv_v) });\n  }\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
