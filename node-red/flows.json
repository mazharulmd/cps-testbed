        "format": "<template>\n  <div style=\"display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end\">\n    <v-text-field v-model=\"name\" label=\"Scenario name\" density=\"compact\" hide-details style=\"max-width:170px\"></v-text-field>\n    <v-text-field v-model.number=\"latency\" type=\"number\" label=\"Latency (ms)\" density=\"compact\" hide-details style=\"max-width:120px\"></v-text-field>\n    <v-text-field v-model.number=\"loss\" type=\"number\" step=\"0.05\" label=\"Loss (0-1)\" density=\"compact\" hide-details style=\"max-width:110px\"></v-text-field>\n    <v-text-field v-model.number=\"droppmu\" type=\"number\" label=\"Drop bus (0=none)\" density=\"compact\" hide-details style=\"max-width:140px\"></v-text-field>\n    <v-switch v-model=\"attack\" label=\"FDI attack\" color=\"red\" density=\"compact\" hide-details></v-switch>\n    <v-btn color=\"primary\" :loading=\"running\" :disabled=\"running\" @click=\"run\">Run scenario</v-btn>\n  </div>\n  <div style=\"margin-top:8px;font-size:14px\" :style=\"{color: error ? '#c62828' : '#0d47a1'}\">{{ status }}</div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return { name: 'web', latency: 20, loss: 0.2, droppmu: 0, attack: false,\n             running: false, error: false, status: 'Ready.' };\n  },\n  methods: {\n    run() {\n      this.send({ payload: { name: this.name, latency: this.latency, loss: this.loss,\n                             droppmu: this.droppmu, attack: this.attack } });\n    }\n  },\n  watch: {\n    msg(m) {\n      if (!m || !m.status) return;\n      this.running = !!m.status.running;\n      this.error = !!m.status.error;\n      this.status = m.status.text;\n    }\n  }\n}\n</script>",
